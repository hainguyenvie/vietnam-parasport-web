{
  "name": "api-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "seed": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/01-core/seed.ts",
    "seed:events": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/02-sports/seed-events.ts",
    "seed:events-expanded": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/02-sports/seed-events-expanded.ts",
    "seed:marketplace": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/03-marketplace/seed-marketplace.ts",
    "seed:affiliate": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/04-affiliate/seed-affiliate.ts",
    "seed:commissions": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/04-affiliate/seed-commissions.ts",
    "seed:achievements": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/05-profiles/seed-achievements.ts",
    "seed:reviews": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/07-testing/seed-reviews.ts",
    "seed:orders": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/07-testing/seed-orders.ts",
    "seed:match-events": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/07-testing/seed-match-events.ts",
    "seed:assignments": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/07-testing/seed-assignments.ts",
    "seed:2fa-oauth": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/07-testing/seed-2fa-oauth.ts",
    "seed:all": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/seed-all.ts",
    "db:reset": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/seed-all.ts",
    "db:fresh": "npx prisma db push --force-reset && npm run seed:all"
  },
  "dependencies": {
    "@keyv/redis": "^4.0.0",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vietnam-parasports/shared": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "cache-manager": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4 || ^1.8",
    "dompurify": "^3.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "ical-generator": "^11.0.0",
    "joi": "^18.2.3",
    "jsdom": "^26.0.0",
    "keyv": "^5.0.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.0 || ^27.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "npx ts-node --project tsconfig.seed.json --transpile-only prisma/seeds/01-core/seed.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
