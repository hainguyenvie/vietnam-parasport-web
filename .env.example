# Copy to .env at repository root; set your own values before deploying.
DB_PASSWORD=replace-with-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
JWT_SECRET=replace-with-strong-random-secret
NEXTAUTH_SECRET=replace-with-a-different-strong-random-secret
MEDIA_SIGNATURE_SECRET=replace-with-same-media-signature-value
NEXT_PUBLIC_MEDIA_SIGNATURE_SECRET=replace-with-same-media-signature-value

# Use your own HTTPS domain in production. For local testing, use
# http://localhost:3000 and http://localhost:3000/api/v1.
NEXTAUTH_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1

# Configure a real SMTP provider if outgoing email is required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Vietnam ParaSports <noreply@your-domain.example>

# Optional: Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=